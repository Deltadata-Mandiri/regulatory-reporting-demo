# Orkes Conductor — credentials stay SERVER-SIDE. Never commit the real .env.
CONDUCTOR_SERVER_URL=https://partner-deltadata.orkesconductor.io/api
CONDUCTOR_AUTH_KEY=
CONDUCTOR_AUTH_SECRET=

# Console
PORT=4400

# Workflow names/versions the proxy is allowed to start and signal
WF_SUBMISSION=regulatory_report_submission
WF_SUBMISSION_VERSION=1
WF_REMEDIATION=breach_remediation
WF_REMEDIATION_VERSION=1
